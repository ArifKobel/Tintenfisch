{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@comments/*": ["./src/comments/*"],
      "@document/*": ["./src/document/*"],
      "@editing/*": ["./src/editing/*"],
      "@engine/*": ["./src/engine/*"],
      "@files/*": ["./src/files/*"],
      "@find/*": ["./src/find/*"],
      "@fonts/*": ["./src/fonts/*"],
      "@forms/*": ["./src/forms/*"],
      "@images/*": ["./src/images/*"],
      "@printing/*": ["./src/printing/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@organize/*": ["./src/organize/*"],
      "@protection/*": ["./src/protection/*"],
      "@redaction/*": ["./src/redaction/*"],
      "@selection/*": ["./src/selection/*"],
      "@shell/*": ["./src/shell/*"],
      "@signing/*": ["./src/signing/*"],
      "@styles/*": ["./src/styles/*"],
      "@testing/*": ["./src/testing/*"],
      "@thumbnails/*": ["./src/thumbnails/*"],
      "@tools/*": ["./src/tools/*"],
      "@ui/*": ["./src/ui/*"],
      "@viewer/*": ["./src/viewer/*"],
      "@wasm/*": ["./engine/wasm/pkg/*"]
    }
  },
  "include": ["src"]
}
